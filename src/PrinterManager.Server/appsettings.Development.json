{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://localhost:5000",
  "Jwt": {
    "Key": "DevOnlyKey-DoNotUseInProduction-MustBeAtLeast32Chars!"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5001", "http://localhost:5173" ]
  },
  "Ldap": {
    "Enabled": false,
    "Server": "ldap.example.com",
    "Port": 389,
    "BaseDn": "dc=example,dc=com",
    "UserDnTemplate": "uid={0},ou=users,dc=example,dc=com"
  }
}
