@page "/security"
@rendermode InteractiveServer
@inject IApiService ApiService
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Sicherheitseinstellungen</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    <RedirectToLogin />
}
else
{
<h1>Sicherheitseinstellungen</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (AuthState.Role != "Administrator")
{
    <div class="alert alert-danger">Nur Administratoren haben Zugriff auf diese Seite.</div>
}
else
{
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(activeTab == "users" ? "active" : "")" @onclick='() => activeTab = "users"' style="cursor: pointer;">Benutzerverwaltung</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "ldap" ? "active" : "")" @onclick='() => activeTab = "ldap"' style="cursor: pointer;">LDAP-Einstellungen</a>
        </li>
    </ul>

    @if (activeTab == "users")
    {
        <h3>Benutzerverwaltung</h3>

        <div class="mb-3">
            <button class="btn btn-primary" @onclick="ShowAddUserForm">Neuer Benutzer</button>
        </div>

        @if (showAddForm)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Neuen Benutzer hinzufügen</h5>
                    <EditForm Model="@newUser" OnValidSubmit="AddUser">
                        <div class="mb-3">
                            <label class="form-label">Benutzername:</label>
                            <InputText class="form-control" @bind-Value="newUser.Username" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Passwort:</label>
                            <InputText type="password" class="form-control" @bind-Value="newUser.Password" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">E-Mail:</label>
                            <InputText class="form-control" @bind-Value="newUser.Email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Vollständiger Name:</label>
                            <InputText class="form-control" @bind-Value="newUser.FullName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Rolle:</label>
                            <InputSelect class="form-control" @bind-Value="newUser.Role">
                                <option value="User">Benutzer</option>
                                <option value="Administrator">Administrator</option>
                            </InputSelect>
                        </div>
                        <button type="submit" class="btn btn-success">Hinzufügen</button>
                        <button type="button" class="btn btn-secondary" @onclick="() => showAddForm = false">Abbrechen</button>
                    </EditForm>
                </div>
            </div>
        }

        @if (users == null)
        {
            <p><em>Laden...</em></p>
        }
        else if (!users.Any())
        {
            <p>Keine Benutzer vorhanden.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Benutzername</th>
                        <th>E-Mail</th>
                        <th>Vollständiger Name</th>
                        <th>Rolle</th>
                        <th>Status</th>
                        <th>LDAP</th>
                        <th>Letzte Anmeldung</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td>@user.Username</td>
                            <td>@(user.Email ?? "-")</td>
                            <td>@(user.FullName ?? "-")</td>
                            <td>
                                <span class="badge bg-@(user.Role == "Administrator" ? "danger" : "primary")">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Aktiv</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inaktiv</span>
                                }
                            </td>
                            <td>
                                @if (user.IsLdapUser)
                                {
                                    <span class="badge bg-info">LDAP</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Lokal</span>
                                }
                            </td>
                            <td>@(user.LastLogin?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td>
                                @if (!user.IsLdapUser && user.Id != 1)
                                {
                                    @if (user.Role == "User")
                                    {
                                        <button class="btn btn-sm btn-warning" @onclick="() => MakeAdmin(user.Id)">Zum Admin machen</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-info" @onclick="() => RemoveAdmin(user.Id)">Admin entfernen</button>
                                    }
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteUser(user.Id)">Löschen</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else if (activeTab == "ldap")
    {
        <h3>LDAP/Active Directory Einstellungen</h3>

        @if (ldapConfig == null)
        {
            <p><em>Laden...</em></p>
        }
        else
        {
            <div class="card">
                <div class="card-body">
                    <EditForm Model="@ldapConfig" OnValidSubmit="SaveLdapConfig">
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="ldapConfig.Enabled" />
                            <label class="form-check-label">LDAP-Authentifizierung aktivieren</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">LDAP-Server:</label>
                            <InputText class="form-control" @bind-Value="ldapConfig.Server" placeholder="ldap.ihrefirma.de" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Port:</label>
                            <InputNumber class="form-control" @bind-Value="ldapConfig.Port" />
                            <div class="form-text">Standard: 389 (LDAP) oder 636 (LDAPS)</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Base DN:</label>
                            <InputText class="form-control" @bind-Value="ldapConfig.BaseDn" placeholder="dc=ihrefirma,dc=de" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">User DN Template:</label>
                            <InputText class="form-control" @bind-Value="ldapConfig.UserDnTemplate" placeholder="uid={0},ou=users,dc=ihrefirma,dc=de" />
                            <div class="form-text">{0} wird durch den Benutzernamen ersetzt</div>
                        </div>
                        <button type="submit" class="btn btn-primary">Einstellungen speichern</button>
                        @if (!string.IsNullOrEmpty(ldapMessage))
                        {
                            <div class="alert alert-success mt-3">@ldapMessage</div>
                        }
                    </EditForm>

                    <div class="alert alert-info mt-3">
                        <strong>Hinweis:</strong> Bei aktiviertem LDAP wird zuerst dort geprüft. Schlägt das
                        fehl, versucht der Server anschließend die lokale Anmeldung — eine fehlerhafte
                        LDAP-Konfiguration sperrt den lokalen Administrator also nicht aus.
                        Auf Port 636 wird LDAPS verwendet, sonst StartTLS versucht.
                    </div>
                </div>
            </div>
        }
    }
}
}

@code {
    private string activeTab = "users";
    private List<UserDto>? users;
    private bool showAddForm = false;
    private RegisterUserDto newUser = new() { Username = "", Password = "" };
    private LdapConfigDto? ldapConfig;
    private string ldapMessage = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        // Ohne Anmeldung keine API-Aufrufe — der Server antwortet sonst mit 401.
        if (!AuthState.IsAuthenticated)
            return;

        if (AuthState.Role == "Administrator")
        {
            await LoadUsers();
            await LoadLdapConfig();
        }
    }

    private async Task LoadUsers()
    {
        try
        {
            users = await ApiService.GetAppUsersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Benutzer konnten nicht geladen werden: {ex.Message}";
        }
    }

    private async Task LoadLdapConfig()
    {
        try
        {
            ldapConfig = await ApiService.GetLdapConfigAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"LDAP-Konfiguration konnte nicht geladen werden: {ex.Message}";
        }
    }

    private void ShowAddUserForm()
    {
        showAddForm = true;
        newUser = new() { Username = "", Password = "", Role = "User" };
    }

    private async Task AddUser()
    {
        errorMessage = "";
        try
        {
            await ApiService.RegisterAppUserAsync(newUser);
            showAddForm = false;
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Benutzer konnte nicht angelegt werden: {ex.Message}";
        }
    }

    private async Task MakeAdmin(int id)
    {
        errorMessage = "";
        try
        {
            await ApiService.UpdateUserRoleAsync(id, "Administrator");
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Rolle konnte nicht geändert werden: {ex.Message}";
        }
    }

    private async Task RemoveAdmin(int id)
    {
        errorMessage = "";
        try
        {
            await ApiService.UpdateUserRoleAsync(id, "User");
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Rolle konnte nicht geändert werden: {ex.Message}";
        }
    }

    private async Task DeleteUser(int id)
    {
        errorMessage = "";
        try
        {
            await ApiService.DeleteAppUserAsync(id);
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Benutzer konnte nicht gelöscht werden: {ex.Message}";
        }
    }

    private async Task SaveLdapConfig()
    {
        errorMessage = "";
        ldapMessage = "";

        if (ldapConfig != null)
        {
            try
            {
                await ApiService.UpdateLdapConfigAsync(ldapConfig);
                ldapMessage = "LDAP-Einstellungen erfolgreich gespeichert!";
            }
            catch (Exception ex)
            {
                errorMessage = $"LDAP-Einstellungen konnten nicht gespeichert werden: {ex.Message}";
            }
        }
    }
}
