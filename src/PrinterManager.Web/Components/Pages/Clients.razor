@page "/clients"
@rendermode InteractiveServer
@inject IApiService ApiService
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Clients</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
}
else
{
<h1>Registrierte Clients</h1>

@if (clients == null)
{
    <p><em>Laden...</em></p>
}
else if (!clients.Any())
{
    <p>Keine Clients registriert.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Hostname</th>
                <th>IP-Adresse</th>
                <th>Betriebssystem</th>
                <th>Status</th>
                <th>Zuletzt gesehen</th>
                @if (AuthState.Role == "Administrator")
                {
                    <th>Aktionen</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var client in clients)
            {
                <tr>
                    <td>
                        <a href="@($"/clients/{client.Id}")" class="text-decoration-none">
                            @client.Hostname
                        </a>
                    </td>
                    <td>@client.IpAddress</td>
                    <td>@client.OperatingSystem</td>
                    <td>
                        @if (client.IsActive)
                        {
                            <span class="badge bg-success">Aktiv</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inaktiv</span>
                        }
                    </td>
                    <td>@client.LastSeen.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                    @if (AuthState.Role == "Administrator")
                    {
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteClient(client.Id)">Löschen</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
}

@code {
    private List<ClientInfo>? clients;

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private async Task LoadClients()
    {
        clients = await ApiService.GetClientsAsync();
    }

    private async Task DeleteClient(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Möchten Sie diesen Client wirklich löschen?");
        if (confirmed)
        {
            var success = await ApiService.DeleteClientAsync(id);
            if (success)
            {
                await LoadClients();
            }
        }
    }
}
