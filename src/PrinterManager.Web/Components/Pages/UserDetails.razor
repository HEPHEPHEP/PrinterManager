@page "/users/{id:int}"
@rendermode InteractiveServer
@inject IApiService ApiService
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>User Details</PageTitle>

@if (!AuthState.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
}
else if (user == null)
{
    <p><em>Laden...</em></p>
}
else
{
<div class="mb-3">
    <a href="/users" class="btn btn-secondary">← Zurück zu Benutzer</a>
</div>

<h1>Benutzer: @user.UserPrincipalName</h1>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Benutzer-Informationen</h5>
        <dl class="row">
            <dt class="col-sm-3">UserPrincipalName:</dt>
            <dd class="col-sm-9">@user.UserPrincipalName</dd>

            <dt class="col-sm-3">Anzeigename:</dt>
            <dd class="col-sm-9">@(user.DisplayName ?? "-")</dd>

            <dt class="col-sm-3">Status:</dt>
            <dd class="col-sm-9">
                @if (user.IsActive)
                {
                    <span class="badge bg-success">Aktiv</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inaktiv</span>
                }
            </dd>

            <dt class="col-sm-3">Zuletzt gesehen:</dt>
            <dd class="col-sm-9">@user.LastSeen.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</dd>
        </dl>
    </div>
</div>

<h3>Zuweisungen</h3>

@if (assignments == null)
{
    <p><em>Lade Zuweisungen...</em></p>
}
else if (!assignments.Any())
{
    <div class="alert alert-info">Keine Zuweisungen vorhanden.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Drucker</th>
                <th>Servicenummer</th>
                <th>Standarddrucker</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var assignment in assignments)
            {
                <tr>
                    <td>@assignment.PrinterName</td>
                    <td>@(assignment.ServiceNumber ?? "-")</td>
                    <td>
                        @if (assignment.IsDefaultPrinter)
                        {
                            <span class="badge bg-success">Ja</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nein</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
}

@code {
    [Parameter]
    public int Id { get; set; }

    private UserInfo? user;
    private List<AssignmentDto>? assignments;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        // Load user info
        var users = await ApiService.GetUsersAsync();
        user = users.FirstOrDefault(u => u.Id == Id);

        if (user == null)
        {
            Navigation.NavigateTo("/users");
            return;
        }

        // Load assignments
        assignments = await ApiService.GetUserAssignmentsAsync(Id);
    }
}
