<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Components.Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <PageTitle>Nicht gefunden – PrinterManager</PageTitle>
        <LayoutView Layout="@typeof(Components.Layout.MainLayout)">
            <p>Entschuldigung, die angeforderte Seite wurde nicht gefunden.</p>
        </LayoutView>
    </NotFound>
</Router>
