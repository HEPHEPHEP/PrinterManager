@inject NavigationManager Navigation

@code {
    // Navigation gehört in den Lebenszyklus, nicht in die Render-Ausgabe: ein
    // NavigateTo mitten im Markup läuft bei jedem Render erneut.
    protected override void OnInitialized()
    {
        // Normalerweise leitet schon die Authentifizierung vor dem Rendern um. Das hier greift
        // nur, wenn eine Seite ohne gültige Anmeldung doch bis zum Router kommt.
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"login?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
