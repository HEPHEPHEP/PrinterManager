@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <h3>Windows Printer Manager</h3>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@* Blazor blendet diese Leiste ein, wenn in einer interaktiven Seite eine unbehandelte
   Ausnahme auftritt. Ohne sie friert die Oberfläche kommentarlos ein. *@
<div id="blazor-error-ui">
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="" class="reload">Neu laden</a>
    <a class="dismiss" title="Schließen">🗙</a>
</div>
